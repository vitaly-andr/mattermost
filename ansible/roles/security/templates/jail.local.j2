[DEFAULT]
bantime = 1800
findtime = 600
maxretry = 10
backend = auto
usedns = warn

# Ignore private networks and localhost
ignoreip = 127.0.0.1/8 ::1 10.0.0.0/16 192.168.0.0/16 172.16.0.0/12 178.34.78.39

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = {{ fail2ban_ssh_maxretry }}
findtime = {{ fail2ban_ssh_findtime }}
bantime = {{ fail2ban_ssh_bantime }}

# Progressive banning for repeat offenders
[recidive]
enabled = false
filter = recidive
logpath = /var/log/fail2ban.log
maxretry = 5      # 5 банов за 24 часа
findtime = 86400  # окно 24 часа
bantime = 86400   # бан на 24 часа

# Mattermost protection (only on chat-sputnik server)
{% if 'chat-sputnik' in inventory_hostname %}
[mattermost-auth]
enabled = true
port = 8065
filter = mattermost-auth
logpath = /var/log/mattermost/mattermost.log
maxretry = 10
bantime = 600
findtime = 600

[mattermost-api]
enabled = true
port = 8065
filter = mattermost-api
logpath = /var/log/mattermost/mattermost.log
maxretry = 50
bantime = 900
findtime = 300
{% endif %}

# Infrastructure services protection (only on etc-sputnik server)
{% if 'etc-sputnik' in inventory_hostname %}
[grafana]
enabled = true
port = 3000
filter = grafana
logpath = /var/log/grafana/grafana.log
maxretry = 10
bantime = 1800

[keycloak]
enabled = true
port = 8081
filter = keycloak
logpath = /opt/keycloak/logs/*.log
maxretry = 10
bantime = 1800

[cockpit]
enabled = true
port = 9090
filter = cockpit
logpath = /var/log/cockpit/cockpit.log
maxretry = 10
bantime = 600

[portainer]
enabled = true
port = 9443
filter = portainer
logpath = /var/log/portainer/portainer.log
maxretry = 10
bantime = 600
{% endif %}