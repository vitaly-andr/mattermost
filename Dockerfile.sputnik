# Mattermost v10.4 - Build from Source for ARM64
# Purpose: Sputnik School custom build with branding
# Architecture: ARM64 (linux/arm64)
# Build method: Multi-stage (webapp → server → runtime)

#
# Stage 1: Webapp Builder (Node.js)
#
FROM --platform=$BUILDPLATFORM node:20-alpine AS webapp
WORKDIR /mattermost

# Install stable build dependencies (available in Alpine main repository)
# These packages are part of Alpine stable and don't require edge repository
RUN apk add --no-cache \
    bash \
    python3 \
    make \
    g++ \
    autoconf \
    automake \
    libtool \
    nasm \
    pkgconf \
    libpng-dev \
    gifsicle \
    optipng

# Install imagemin native dependencies from Alpine edge repository (ARM64 requirement)
#
# Background: Alpine 3.20 stable lacks libimagequant 4.x and mozjpeg packages
# These are REQUIRED for successful compilation of:
#   - imagemin-pngquant (needs libimagequant-dev 4.x)
#   - imagemin-mozjpeg (needs mozjpeg-dev)
#
# Versions are PINNED to prevent unexpected breaking changes during rebuilds
# If these versions become unavailable, build will fail explicitly (desired behavior)
# rather than silently pulling incompatible versions
#
# Migration path: Monitor Alpine 3.21+ stable releases
# When these packages appear in stable main/community repositories,
# migrate back to stable to reduce edge repository dependency
#
# Review date: 2025-04-17 (6 months from implementation)
# Last verified: 2025-10-17
RUN apk add --no-cache \
    --repository=http://dl-cdn.alpinelinux.org/alpine/edge/community \
    libimagequant-dev=4.3.3-r0 \
    mozjpeg-dev=4.1.5-r0

# Copy all webapp source code (needed for postinstall scripts)
COPY webapp/ ./webapp/

# Install dependencies
WORKDIR /mattermost/webapp
RUN npm ci --legacy-peer-deps && \
    npm install --save-dev imagemin-pngquant imagemin-mozjpeg imagemin-gifsicle imagemin-svgo

# Build webapp (webpack compilation)
WORKDIR /mattermost/webapp/channels
RUN npm run build

#
# Stage 2: Server Builder (Go)
#
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS server
WORKDIR /mattermost

# Install build dependencies
RUN apk add --no-cache make git

# Copy Go module files first for better layer caching
COPY server/go.mod server/go.sum ./server/
WORKDIR /mattermost/server
RUN go mod download

# Copy server source code
WORKDIR /mattermost
COPY server/ ./server/

# Build server binary
WORKDIR /mattermost/server
ARG TARGETOS=linux
ARG TARGETARCH=arm64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -a -installsuffix cgo -ldflags="-s -w" \
    -o dist/mattermost \
    ./cmd/mattermost

#
# Stage 3: Runtime Image
#
FROM alpine:3.19
LABEL maintainer="vitaly@sputnik.school"
LABEL description="Mattermost v10.4 - Built from source for ARM64 with Sputnik branding"
LABEL org.opencontainers.image.source="https://github.com/mattermost/mattermost"
LABEL org.opencontainers.image.version="10.4-sputnik"

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    tzdata \
    libcap \
    mailcap \
    netcat-openbsd \
    && rm -rf /var/cache/apk/*

# Create mattermost user and group
RUN addgroup -g 2000 mattermost && \
    adduser -D -u 2000 -G mattermost -h /mattermost mattermost

WORKDIR /mattermost

# Copy server binary from builder stage
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/dist/mattermost ./bin/mattermost

# Copy webapp assets from builder stage
COPY --from=webapp --chown=mattermost:mattermost \
    /mattermost/webapp/channels/dist ./client/

# Copy additional server files
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/fonts ./fonts
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/templates ./templates
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/i18n ./i18n

# Create necessary directories
RUN mkdir -p data logs config plugins client/plugins && \
    chown -R mattermost:mattermost /mattermost

# Grant network binding capability
RUN setcap cap_net_bind_service=+ep ./bin/mattermost

# Switch to non-root user
USER mattermost

# Expose ports
EXPOSE 8065 8443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8065/api/v4/system/ping || exit 1

# Volumes for persistent data
VOLUME ["/mattermost/data", "/mattermost/logs", "/mattermost/config", "/mattermost/plugins"]

# Default command
CMD ["./bin/mattermost"]
