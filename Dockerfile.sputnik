# Mattermost v10.4 - Build from Source for ARM64
# Purpose: Sputnik School custom build with branding
# Architecture: ARM64 (linux/arm64)
# Build method: Multi-stage (webapp → server → runtime)

#
# Stage 1: Webapp Builder (Node.js)
#
FROM --platform=$BUILDPLATFORM node:20-alpine AS webapp
WORKDIR /mattermost

# Install build dependencies for native npm modules
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    autoconf \
    automake \
    libtool \
    nasm

# Copy webapp package files first for better layer caching
COPY webapp/package*.json ./webapp/
COPY webapp/channels/package*.json ./webapp/channels/
COPY webapp/platform/client/package.json ./webapp/platform/client/
COPY webapp/platform/types/package.json ./webapp/platform/types/

# Install dependencies
WORKDIR /mattermost/webapp
RUN npm ci --legacy-peer-deps

# Copy webapp source code
COPY webapp/ ./

# Build webapp (webpack compilation)
WORKDIR /mattermost/webapp/channels
RUN npm run build

#
# Stage 2: Server Builder (Go)
#
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS server
WORKDIR /mattermost

# Install build dependencies
RUN apk add --no-cache make git

# Copy Go module files first for better layer caching
COPY server/go.mod server/go.sum ./server/
WORKDIR /mattermost/server
RUN go mod download

# Copy server source code
WORKDIR /mattermost
COPY server/ ./server/

# Build server binary
WORKDIR /mattermost/server
ARG TARGETOS=linux
ARG TARGETARCH=arm64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -a -installsuffix cgo -ldflags="-s -w" \
    -o dist/mattermost \
    ./cmd/mattermost

#
# Stage 3: Runtime Image
#
FROM alpine:3.19
LABEL maintainer="vitaly@sputnik.school"
LABEL description="Mattermost v10.4 - Built from source for ARM64 with Sputnik branding"
LABEL org.opencontainers.image.source="https://github.com/mattermost/mattermost"
LABEL org.opencontainers.image.version="10.4-sputnik"

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    curl \
    tzdata \
    libcap \
    mailcap \
    netcat-openbsd \
    && rm -rf /var/cache/apk/*

# Create mattermost user and group
RUN addgroup -g 2000 mattermost && \
    adduser -D -u 2000 -G mattermost -h /mattermost mattermost

WORKDIR /mattermost

# Copy server binary from builder stage
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/dist/mattermost ./bin/mattermost

# Copy webapp assets from builder stage
COPY --from=webapp --chown=mattermost:mattermost \
    /mattermost/webapp/channels/dist ./client/

# Copy additional server files
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/fonts ./fonts
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/templates ./templates
COPY --from=server --chown=mattermost:mattermost \
    /mattermost/server/i18n ./i18n

# Create necessary directories
RUN mkdir -p data logs config plugins client/plugins && \
    chown -R mattermost:mattermost /mattermost

# Grant network binding capability
RUN setcap cap_net_bind_service=+ep ./bin/mattermost

# Switch to non-root user
USER mattermost

# Expose ports
EXPOSE 8065 8443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8065/api/v4/system/ping || exit 1

# Volumes for persistent data
VOLUME ["/mattermost/data", "/mattermost/logs", "/mattermost/config", "/mattermost/plugins"]

# Default command
CMD ["./bin/mattermost"]
